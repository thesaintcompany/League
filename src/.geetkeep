# Force LF line endings for all text files (cross-platform consistency)
* text=auto eol=lf

# Shell scripts always LF
*.sh text eol=lf

# Batch files always CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files - no conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.db binary
*.db-journal binary
