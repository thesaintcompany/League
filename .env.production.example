# Production environment for Coolify / self-hosted deploys.
# Copy these into Coolify → Application → Environment Variables
# (do NOT commit a .env file with real secrets).

# ---- Database ----
# SQLite file path inside the container.
# Pair this with a Persistent Volume mounted at /app/prisma so the file survives redeploys.
DATABASE_URL=file:./dev.db

# ---- NextAuth ----
# Public URL of the deployed app, no trailing slash.
NEXTAUTH_URL=https://sp.buu.ro

# Long random string, at least 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   or:  openssl rand -base64 32
NEXTAUTH_SECRET=replace-me-with-a-random-32+char-string

# ---- Optional: bootstrap admin ----
# If both are set, a user is created on first start (and only if it doesn't already exist).
# Use this so you can log in immediately after a fresh deploy.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=choose-a-strong-password
# ADMIN_NAME=Site Admin

# ---- Optional: demo seed ----
# Set to "0" to skip seeding demo@leaguehub.local + Liga Demo 2026.
# Default behavior: 1 if no ADMIN_EMAIL is set, 0 if ADMIN_EMAIL is set.
# SEED_DEMO=1
