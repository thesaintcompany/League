# Production environment for Coolify / self-hosted deploys.
# Copy these into Coolify → Application → Environment Variables
# (do NOT commit a .env file with real secrets).

# ---- Database ----
# SQLite file path inside container.
# Pair this with a Persistent Volume mounted at /app/data so the database survives redeploys.
# In Coolify: Application → Settings → Persistent Storage
#   Mount Path : /app/data
#   Host Path  : /data/coolify/applications/ywnjhof6n0shigudwnwm5x93/bs-persistenta
DATABASE_URL=file:/app/data/league.db

# ---- NextAuth ----
# Public URL of the deployed app, no trailing slash.
NEXTAUTH_URL=https://sp. ligue.ro

# Long random string, at least 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   or:  openssl rand -base64 32
NEXTAUTH_SECRET=replace-me-with-a-random-32+char-string

# ---- Optional: bootstrap admin ----
# If set, this admin user is created on first start.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=choose-a-strong-password
# ADMIN_NAME=Site Admin
