// Prisma schema for Sport League Organizer (Ligue Pro)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          String   @default("organizer") // "organizer" | "referee" | "player" | "arena_owner" | "team_leader" | "observer"
  isActive      Boolean  @default(true)
  signupIp      String?  // Adresa IP de la înregistrare
  
  // Profile fields for various roles
  primarySport   String?  @default("fotbal") // sportul practicat (fotbal, tenis, padel, pingpong, baschet, volei, handbal)
  phone          String?
  bio            String?
  coverPhotoUrl  String? // poză în picioare / full-body action shot
  position       String? // for players (ex: Atacant, Mijlocas, Portar)
  jerseyNumber   Int?    // for players
  preferredFoot  String? // for players (Drept, Stang, Ambele)
  heightCm       Int?    // inaltime cm
  weightKg       Int?    // greutate kg
  instagramUrl   String? // retele sociale
  twitterUrl     String?
  facebookUrl    String?
  refereeBadge   String? // for referees ( , National, Regional)
  experienceYears Int?   // for referees

  // Member card (physical card) fields populated via invite card flow
  memberCardNumber String?
  memberCardUrl    String?
  memberCardExpires DateTime?

  // Manager Gamification & Profile
  managerXp        Int      @default(0)
  managerBadge     String?  @default("Manager Debutant")
  xpHistory        String?  // JSON string: [{ action, xp, timestamp, description }]
  coachingLicense  String?  // Licență Antrenorat / Management (ex: UEFA B, UEFA A, Director Sportiv)
  companyName      String?  // Nume Companie Facturare
  companyCui       String?  // CUI / CIF Companie
  billingAddress   String?  // Adresă de facturare

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

   accounts        Account[]
   sessions        Session[]
   championships   Championship[]
   venues          Venue[]
   venueClaims     VenueClaim[]
   managedTeams    Team[]        @relation("ManagedTeams")
    sentTeamInvitations TeamInvitation[] @relation("TeamInvitationInviter")
    externalInvites ExternalInvite[]
    paymentMethods  PaymentMethod[]
    invoices        Invoice[]
    notifications   Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Venue {
  id            String   @id @default(cuid())
  name          String
  location      String
  county        String?  // e.g. "București", "Cluj", "Timiș", "Dolj", "Argeș", "Bihor", "Brașov"
  status        String   @default("activ") // "activ", "constructie", "proiect"
  address       String?
  specs         String?
  amenities     String?  // JSON string: configurable arena facilities
  sport         String   @default("fotbal") // fotbal, baschet, volei, handbal, multifunctional
  surface       String   @default("Sintetic") // Sintetic, Gazon Natural, Parchet, Mixt, Nisip, Indoor
  capacity      Int      @default(100)
  floodlights   Boolean  @default(true)
  isActive      Boolean  @default(true)
  pricePerHour  Int?
  imageUrl      String?
  galleryImages String?  // JSON string: array of four public gallery image URLs
  ownerId       String?
  ads           String?  // JSON string: array of { id, title, imageUrl, linkUrl, isActive }
  announcements String?  // JSON string: array of { id, title, content, date, isActive }
  tickerText    String?  // Scrolling ticker announcement
  tickerActive  Boolean  @default(false)
  tickerSpeed   Int      @default(20)
  isDemo        Boolean  @default(false) // Arena demonstrativă: protejată de ștergere (100% safe)
  calendarSyncUrl String? // URL for external .ics sync (e.g. Google Calendar)
  createdAt     DateTime @default(now())

  owner         User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  claims        VenueClaim[]
  blockedSlots  VenueBlockedSlot[]
}

model VenueBlockedSlot {
  id        String   @id @default(cuid())
  venueId   String
  title     String   @default("Ocupat Extern")
  startTime DateTime
  endTime   DateTime
  createdAt DateTime @default(now())

  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
}

model Championship {
  id          String   @id @default(cuid())
  name        String
  sport       String   // fotbal, baschet, handbal, volei, custom
  format      String   // "round_robin" | "knockout" | "groups_knockout"
  season      String?
  startDate   DateTime
  endDate     DateTime?
  description String?
  scope       String   @default("national") // "national" | "judetean" | "oras"
  county      String?  // e.g. "Timiș", "București", "Cluj", "Iași", "Brașov"
  city        String?  // e.g. "Timișoara", "Cluj-Napoca", "București"
  logoUrl     String?  // URL sau cale către sigla rotundă a campionatului
  isBracketPublished Boolean @default(false)
  diceRollCount      Int     @default(0) // Maximum 3 rolls allowed before publishing
  silentDice         Boolean @default(false) // Dezactivează anunțurile cu zaruri (Tragere Silent)
  refereeEnabled     Boolean @default(true)  // Activare modul arbitraj  
  singleVenueEnabled Boolean @default(false) // Toate meciurile în aceeași locație/arenă
  defaultVenue       String?                 // Numele locației unice
  shareCode   String?  @unique // unique public share code e.g. "LP-2026-A1"
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  teams   Team[]
  matches Match[]
  teamInvitations TeamInvitation[]
  externalInvites ExternalInvite[]

  @@index([ownerId])
}

model Team {
  id              String  @id @default(cuid())
  name            String
  shortName       String? // 3-letter code
  color           String? // hex
  logoUrl         String?
  coverPhotoUrl   String? // Poza de grup cu echipa / cover stadion
  championshipId  String
  managerId       String?
  managerEmail    String? // Emailul liderului/managerului invitat
  manager         User?   @relation("ManagedTeams", fields: [managerId], references: [id], onDelete: SetNull)
  headCoach       String?
  assistantCoach  String?
  medic           String?
  fitnessCoach    String?
  formation       String? @default("4-3-3") // "4-3-3", "4-4-2", "3-5-2"
  homeArena       String?
  sport           String? @default("fotbal")
  description     String?
  sponsors        String? // JSON string: [{ id, name, logoUrl, linkUrl, tier }]
  createdAt       DateTime @default(now())

  subscriptionActive    Boolean   @default(false)
  subscriptionStartAt   DateTime?
  subscriptionExpiresAt DateTime?

  // GPS Stadium Check-in & Presence Report
  lastCheckInAt       DateTime?
  checkInVenue        String?
  checkInLatitude     Float?
  checkInLongitude    Float?
  checkInVerified     Boolean   @default(false)
  attendanceReport    String?   // JSON string: [{ id, name, number, present, checkedAt }]
  fairPlayScore       Float?    @default(5.0)
  fairPlayReportsCount Int      @default(0)

   championship Championship @relation(fields: [championshipId], references: [id], onDelete: Cascade)
   players       Player[]
   homeMatches    Match[] @relation("HomeTeam")
   awayMatches    Match[] @relation("AwayTeam")
    invitations   TeamInvitation[]
    externalInvites ExternalInvite[]
    invoices      Invoice[]
    news          TeamNews[]

   @@index([championshipId])
   @@index([managerId])
}

model PaymentMethod {
   id              String   @id @default(cuid())
   userId          String
   type            String   // "stripe_card" | "paypal" | "apple_pay" | "google_pay"
   provider        String   // "stripe" | "paypal" | "apple" | "google"
   providerId      String?  // external customer id / setup intent id
   cardBrand       String?  // visa, mastercard, etc (pentru carduri)
   cardLast4       String?  // ultimele 4 cifre card
   cardExpMonth    Int?
   cardExpYear     Int?
   cardHolder      String?  // numele titularului de pe card
   isDefault       Boolean  @default(false)
   isActive        Boolean  @default(true)
   createdAt       DateTime @default(now())
   updatedAt       DateTime @updatedAt

   user User @relation(fields: [userId], references: [id], onDelete: Cascade)

   @@index([userId])
}

model Invoice {
   id              String   @id @default(cuid())
   userId          String?
   teamId          String?
   amount          Float    // în EUR
   currency        String   @default("EUR")
   status          String   @default("pending") // "pending" | "paid" | "failed" | "refunded"
   paymentMethod   String?  // "stripe_card" | "paypal" etc
   paymentIntentId String?  // Stripe payment intent id
   invoiceNumber   String   @unique // ex: INV-2026-001
   series          String   @default("INV") // seria facturii
   issueDate       DateTime @default(now())
   dueDate         DateTime // data de plată
   paidAt          DateTime?
   lineItems       String?    // JSON string: [{ description, quantity, unitPrice, total }]
   subtotal        Float
   taxAmount       Float?   @default(0) // TVA
   totalAmount     Float
   companyName     String?
   companyCui      String?
   companyAddress  String?
   companyPhone    String?
   companyEmail    String?
   customerName    String?
   customerEmail   String?
   notes           String?
   createdAt       DateTime @default(now())
   updatedAt       DateTime @updatedAt

   user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
   team Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

   @@index([userId])
   @@index([teamId])
   @@index([invoiceNumber])
}

model Player {
  id              String   @id @default(cuid())
  name            String
  email           String?
  number          Int?
  position        String?
  status          String   @default("active") // "active", "invited", "reserve"
  isStarter       Boolean  @default(true)
  invitationToken String?
  goals           Int      @default(0)
  matchesCount    Int      @default(0)
  assists         Int      @default(0)
  rating          Float    @default(8.5)
  yellowCards     Int      @default(0)
  redCards        Int      @default(0)
  suspensions     Int      @default(0)
  image           String?
  teamId          String
  createdAt       DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

model Match {
  id              String   @id @default(cuid())
  championshipId  String
  homeTeamId      String
  awayTeamId      String
  scheduledAt     DateTime
  venue           String?
  referee         String?  // Nume sau ID arbitru desemnat
  stage           String?  // "group" | "quarter_final" | "semi_final" | "final"
  bracketIndex    Int?     // Index în arborele de joc (0, 1, 2, 3...)
  round           Int      @default(1)
  status          String   @default("scheduled") // scheduled | live | finished
  homeScore       Int?
  awayScore       Int?
  notes           String?

  // Match telemetry and referee official report
  events          String?  // JSON stringified array of match events (goals, cards, offsides, subs)
  homeOffsides    Int      @default(0)
  awayOffsides    Int      @default(0)
  homeFouls       Int      @default(0)
  awayFouls       Int      @default(0)
  homeCorners     Int      @default(0)
  awayCorners     Int      @default(0)
  homePenalties   String?  // JSON stringified array of shootout results
  awayPenalties   String?  // JSON stringified array of shootout results
  pitchCondition  String?  @default("Excelent")
  crowdConduct    String?  @default("Sportivă / Fără incidente")
  refereeNotes    String?  // Raportul   de meci și incidente
   signedBy        String?  // Semnătura digitală a arbitrului
   signedAt        DateTime?
   refereeConfirmed Boolean     @default(false) // Arbitrul a confirmat prezența
   refereeConfirmedAt DateTime? // Când arbitrul a confirmat
   refereeDeclined Boolean    @default(false) // Arbitrul a refuzat
  // Match promo, tickets, and sponsor ads
  ticketPrice     Int?     @default(25)
  ticketUrl       String?
  sponsorName     String?  @default("Ligue Pro Energy")
  sponsorLogoUrl  String?
  sponsorTagline  String?  @default("Partener   de Performanță")

  // Organizer Payout & Gatekeeper Access Secret
  organizerIban          String?
  organizerBank          String?
  organizerAccountHolder String?
  gateAccessSecret       String?  @default(cuid())

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  championship Championship @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  homeTeam     Team         @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam     Team         @relation("AwayTeam", fields: [awayTeamId], references: [id])
  ticketTiers  TicketTier[]
  tickets      Ticket[]
  promoCodes   TicketPromoCode[]

  @@index([championshipId])
  @@index([scheduledAt])
}

model SystemSetting {
  id                    String   @id @default("default")
  activeLogoUrl         String   @default("/images/logos/logo-1.png") // Logo-ul principal activ selectat de SuperAdmin
  companyName           String?  @default(" ligue.ro S.R.L.")
  companyCui            String?  @default("RO12345678")
  companyRegCom         String?  @default("J35/123/2024")
  companyAddress        String?  @default("Timișoara, Județul Timiș, România")
  companyEmail          String?  @default("contact@ligue.ro")
  companyPhone          String?  @default("+40 700 000 000")
  platformFeePercent    Float    @default(10.0) // Comision platformă Super Admin %
  stripePublishableKey  String?
  stripeSecretKey       String?
  stripeWebhookSecret   String?
  paypalClientId        String?
  applePayMerchantId    String?  @default("merchant.ro.buu.league")
  applePayDomainVerified Boolean @default(true)
  applePayEnabled       Boolean  @default(true)
  googlePayMerchantId   String?  @default("buu-ro-league-pay")
  googlePayEnvironment  String?  @default("PRODUCTION")
  googlePayEnabled      Boolean  @default(true)
  payoutMinThreshold    Int      @default(100)
  demoPreFillDisabled   Boolean  @default(false)
  teamSubscriptionPrice Float    @default(60.0) // Preț abonament anual pentru echipe suplimentare (EUR)
  seasonYear            Int?     // Anul manual al sezonului setat de SuperAdmin (ex: 2027)
  seasonMode            String   @default("auto") // "auto" (automat în funcție de timp) sau "manual" (setat manual de SuperAdmin)

  // Configurare Pagină 404 (Not Found)
  notFoundTitle           String?  @default("Pagina nu a fost găsită")
  notFoundMessage         String?  @default("Ne pare rău, pagina pe care o căutați nu există, a fost mutată sau adresa URL a fost introdusă greșit.")
  notFoundCountdown       Int      @default(10) // Durată countdown redirecționare automată (secunde)
  notFoundRedirectEnabled Boolean  @default(true) // Comutator activare/dezactivare redirecționare
  notFoundButtonText      String?  @default("Mergi la Pagina Principală")
  notFoundRedirectUrl     String?  @default("/")

  updatedAt             DateTime @updatedAt
}

model TicketTier {
  id          String   @id @default(cuid())
  matchId     String
  name        String   // e.g. "Tribuna 1 Central", "Peluza Nord", "Loja VIP"
  price       Float    @default(25.0)
  totalSeats  Int      @default(100)
  soldSeats   Int      @default(0)
  gateNumber  String?  @default("Poarta A (Nord)")
  createdAt   DateTime @default(now())

  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  tickets     Ticket[]

  @@index([matchId])
}

model TicketPromoCode {
  id             String   @id @default(cuid())
  matchId        String
  code           String
  maxRedemptions Int      @default(5)
  redeemedCount  Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  match          Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, code])
  @@index([matchId, isActive])
}

model Ticket {
  id              String    @id @default(cuid())
  ticketCode      String    @unique // e.g. "TCK-2026-98FA"
  matchId         String
  tierId          String?
  buyerName       String
  buyerEmail      String
  buyerPhone      String?
  seatSector      String    @default("Tribuna 1")
  seatRow         String?   @default("Rând 5")
  seatNumber      String?   @default("Loc 12")
  price           Float     @default(25.0)
  platformFee     Float     @default(2.5) // Cota platformei
  organizerPayout Float     @default(22.5) // Cota organizatorului
  paymentMethod   String    @default("card") // card | paypal | apple_pay | google_pay
  paymentStatus   String    @default("paid") // paid | pending | refunded
  status          String    @default("valid") // valid | used | cancelled
  qrPayload       String    // Signature / Verification token
  checkedInAt     DateTime?
  checkedInBy     String?   // Nume steward sau poartă
  createdAt       DateTime  @default(now())

  match           Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  tier            TicketTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)

  @@index([matchId])
  @@index([ticketCode])
}

model VenueClaim {
  id              String   @id @default(cuid())
  venueId         String
  applicantName   String
  applicantEmail  String
  applicantPhone  String
  companyName     String   // Companie / Club / Primărie / Entitate Juridică
  companyCui      String   // CUI / CIF / Cod Fiscal
  companyRegCom   String?  // Nr. Reg. Comerțului / Act Înființare
  jobTitle        String   // Funcție (ex: Administrator Bază, Director General, Reprezentant Legal)
  justification   String?  // Detalii suplimentare / Mesaj
  status          String   @default("pending") // "pending" | "approved" | "rejected"
  userId          String?  // Contul de utilizator asociat dacă există
  reviewerNotes   String?  // Note ale SuperAdmin-ului la aprobare/respingere
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  venue           Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([venueId])
  @@index([status])
  @@index([applicantEmail])
}

model TeamInvitation {
  id              String   @id @default(cuid())
  teamId          String
  championshipId  String
  inviterId       String
  inviteeEmail    String
  status          String   @default("pending") // "pending" | "accepted" | "rejected"
  message         String?
  respondedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  championship Championship @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  inviter     User         @relation("TeamInvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([championshipId])
  @@index([inviteeEmail])
}

model ExternalInvite {
  id              String   @id @default(cuid())
  token           String   @unique
  acceptToken     String?  @unique // for the pre-account info-collection step
  accountOfferToken String? @unique // for the password-set-to-create-account step
  cardToken       String?  @unique // for the member-card/photo upload step
  teamId          String
  championshipId  String
  inviterId       String
  sport           String
  inviteeEmail    String
  inviteeName     String?
  stage           String   @default("pending") // pending | info_collected | confirmed | account_created | card_done
  offerExpiresAt  DateTime?
  accountOfferExpires DateTime?
  cardTokenExpires DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  championship Championship @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  inviter     User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([acceptToken])
  @@index([accountOfferToken])
  @@index([inviteeEmail])
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  html      String
  text      String?
  status    String   @default("queued") // queued | sent | failed | dev_logged
  createdAt DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  userEmail   String?
  userName    String?
  userRole    String?
  action      String   // AUTH_LOGIN, AUTH_SIGNUP, CHAMPIONSHIP_CREATE, MATCH_UPDATE, VENUE_UPDATE, PLAYER_ADD, GDPR_DELETE_REQUEST, etc.
  details     String?  // Description of changes or payload
  ipAddress   String?
  userAgent   String?
  entityType  String?  // user, championship, match, venue, team, gdpr
  entityId    String?
  status      String   @default("success") // success | warning | error | blocked
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([userEmail])
  @@index([action])
  @@index([createdAt])
}

model GdprRequest {
  id          String   @id @default(cuid())
  userId      String?
  userEmail   String
  userName    String?
  userRole    String?
  reason      String?
  status      String   @default("pending") // pending | approved | completed | rejected
  requestedAt DateTime @default(now())
  processedAt DateTime?
  processedBy String?
  notes       String?

  @@index([userEmail])
  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String?
  type      String   // "team_invite" | "team_removed" | "team_joined" | "championship_invite" | "system"
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  teamId    String?
  teamName  String?
  teamLogo  String?
  metadata  String?  // JSON string
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userEmail])
  @@index([read])
  @@index([createdAt])
}

model TeamNews {
  id        String   @id @default(cuid())
  teamId    String
  title     String
  content   String
  category  String   @default("breaking") // "breaking" | "transfer" | "comunicat" | "match" | "attendance"
  badge     String?  @default("BREAKING NEWS")
  author    String?  @default("Departamentul Media & Părinți")
  imageUrl  String?
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([createdAt])
}

